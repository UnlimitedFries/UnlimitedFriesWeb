---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('devlog', (p) => !p.data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<BaseLayout
  title="Devlog"
  description="Progress updates and behind-the-scenes notes from Unlimited Fries."
>
  <div class="container-page pt-36 md:pt-44">
    <p class="tag text-ash" data-reveal>Notes from the build</p>
    <h1 class="mt-4 text-[clamp(5rem,20vw,18rem)] leading-[0.8]">
      <span class="mask"><span>Devlog</span></span>
    </h1>
    <ul class="border-bone/15 mt-16 border-b">
      {
        posts.map((post, i) => (
          <li data-reveal style={`--d: ${i * 0.06}s`}>
            <a
              href={`/devlog/${post.id}/`}
              class="group border-bone/15 relative isolate grid gap-3 overflow-hidden border-t py-8 md:grid-cols-12 md:gap-8"
              data-cursor="Read"
            >
              <span class="bg-bone absolute inset-0 -z-10 origin-bottom scale-y-0 transition-transform duration-500 ease-(--ease-out-expo) group-hover:scale-y-100" />
              <time
                datetime={post.data.date.toISOString()}
                class="tag text-ash group-hover:text-ink/60 pt-2 transition-colors md:col-span-3 md:pl-4"
              >
                {post.data.date.toLocaleDateString('en-US', { dateStyle: 'long', timeZone: 'UTC' })}
              </time>
              <div class="group-hover:text-ink transition-[color,translate] duration-500 ease-(--ease-out-expo) group-hover:translate-x-3 md:col-span-8">
                <h2 class="text-4xl md:text-6xl">{post.data.title}</h2>
                <p class="mt-3 max-w-xl opacity-70">{post.data.description}</p>
              </div>
              <span class="group-hover:text-ink hidden pt-2 text-right text-3xl transition-[color,translate] duration-500 ease-(--ease-out-expo) group-hover:-translate-x-4 md:block">
                &rarr;
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
