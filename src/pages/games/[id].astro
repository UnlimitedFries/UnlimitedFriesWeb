---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DragStrip from '../../components/DragStrip.astro';

export async function getStaticPaths() {
  const games = await getCollection('games');
  return games.map((game) => ({ params: { id: game.id }, props: { game } }));
}

const { game } = Astro.props;
const { Content } = await render(game);
const { data } = game;

const stats = [
  { label: 'Status', value: data.status },
  { label: 'Platform', value: data.platforms.join(', ') },
  data.releaseDate && { label: 'Released', value: data.releaseDate },
  data.price && { label: 'Price', value: data.price },
].filter(Boolean) as { label: string; value: string }[];

const links = [
  data.steamUrl && { label: 'Get it on Steam', url: data.steamUrl, solid: true },
  data.itchUrl && { label: 'itch.io', url: data.itchUrl },
  data.websiteUrl && { label: 'Game website', url: data.websiteUrl },
  data.discordUrl && { label: 'Discord', url: data.discordUrl },
  data.trailerUrl && { label: 'YouTube', url: data.trailerUrl },
].filter(Boolean) as { label: string; url: string; solid?: boolean }[];
---

<BaseLayout title={data.title} description={data.tagline}>
  <section class="relative isolate flex min-h-[92svh] flex-col justify-end overflow-hidden">
    {
      data.cover && (
        <img
          src={data.cover}
          alt=""
          data-parallax="0.3"
          class="absolute inset-x-0 -top-[10%] -z-20 h-[120%] w-full object-cover opacity-60"
        />
      )
    }
    <div class="from-ink via-ink/60 absolute inset-0 -z-10 bg-linear-to-t from-15% via-45% to-transparent"></div>
    <div class="container-page pt-32 pb-12">
      <a href="/games/" class="tag text-bone/70 link-sweep" data-reveal>&larr; All games</a>
      <h1 class="mt-6 text-[clamp(5rem,22vw,20rem)] leading-[0.8]">
        <span class="mask"><span>{data.title}</span></span>
      </h1>
      <p class="text-bone/85 mt-8 max-w-xl text-xl" data-reveal style="--d: 0.15s">
        {data.tagline}
      </p>
    </div>
  </section>

  <div class="container-page">
    <dl class="border-bone/15 grid grid-cols-2 border-t md:grid-cols-4">
      {
        stats.map((s, i) => (
          <div
            class="border-bone/15 border-b py-5 pr-4 md:border-r md:px-5 md:first:pl-0 md:last:border-r-0"
            data-reveal
            style={`--d: ${i * 0.06}s`}
          >
            <dt class="tag text-ash">{s.label}</dt>
            <dd class="mt-2 text-lg font-medium">{s.value}</dd>
          </div>
        ))
      }
    </dl>

    {
      data.steamReviews && (
        <p class="tag text-bone/70 mt-6 flex items-center gap-3" data-reveal>
          <span class="bg-fry inline-block size-1.5 rounded-full" />
          Steam: {data.steamReviews}
        </p>
      )
    }

    <div class="mt-10 flex flex-wrap gap-3" data-reveal>
      {
        links.map((l) => (
          <a class:list={['btn', l.solid && 'btn-solid']} href={l.url} rel="noopener" data-magnetic>
            {l.label} <span class="arrow">&nearr;</span>
          </a>
        ))
      }
    </div>

    {
      data.gallery.length > 0 && (
        <div class="mt-24">
          <DragStrip images={data.gallery} alt={`${data.title} screenshot`} />
        </div>
      )
    }

    {
      data.press.map((p) => (
        <figure class="my-28 md:my-40">
          <blockquote class="font-display max-w-5xl text-[clamp(2.5rem,6vw,5.5rem)] leading-[0.95] font-bold uppercase">
            <span class="text-fry">&ldquo;</span>
            <span data-words>{p.quote}</span>
            <span class="text-fry">&rdquo;</span>
          </blockquote>
          <figcaption class="tag text-ash mt-8" data-reveal>
            &mdash; {p.url ? <a class="link-sweep" href={p.url}>{p.source}</a> : p.source}
          </figcaption>
        </figure>
      ))
    }

    <div class="grid gap-10 md:grid-cols-12">
      <p class="tag text-ash md:col-span-3" data-reveal>About the game</p>
      <div class="prose-grit md:col-span-8" data-reveal>
        <Content />
      </div>
    </div>
  </div>
</BaseLayout>
