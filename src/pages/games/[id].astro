---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DragStrip from '../../components/DragStrip.astro';

export async function getStaticPaths() {
  const games = await getCollection('games');
  return games.map((game) => ({ params: { id: game.id }, props: { game } }));
}

const { game } = Astro.props;
const { Content } = await render(game);
const { data } = game;
---

<BaseLayout title={data.title} description={data.tagline}>
  <article class="container-page max-w-4xl pt-16">
    <a href="/games/" class="hud hover:text-fry underline">&larr; All games</a>
    <p class="hud text-fry mt-8">[{data.status}]</p>
    <h1 class="mt-2 text-5xl md:text-6xl">{data.title}</h1>
    <p class="mt-4 text-xl">{data.tagline}</p>

    <dl class="mt-8 flex flex-wrap gap-x-10 gap-y-2 text-sm">
      <div>
        <dt class="font-bold">Platforms</dt>
        <dd>{data.platforms.join(', ')}</dd>
      </div>
      {
        data.releaseDate && (
          <div>
            <dt class="font-bold">Release</dt>
            <dd>{data.releaseDate}</dd>
          </div>
        )
      }
      {
        data.price && (
          <div>
            <dt class="font-bold">Price</dt>
            <dd>{data.price}</dd>
          </div>
        )
      }
      {
        data.steamReviews && (
          <div>
            <dt class="font-bold">Steam reviews</dt>
            <dd>{data.steamReviews}</dd>
          </div>
        )
      }
    </dl>

    <div class="mt-8 flex flex-wrap gap-4">
      {
        data.steamUrl && (
          <a class="btn" href={data.steamUrl} rel="noopener">
            Steam
          </a>
        )
      }
      {
        data.itchUrl && (
          <a class="btn" href={data.itchUrl} rel="noopener">
            itch.io
          </a>
        )
      }
      {
        data.websiteUrl && (
          <a class="btn btn-dark" href={data.websiteUrl} rel="noopener">
            Game website
          </a>
        )
      }
      {
        data.discordUrl && (
          <a class="btn btn-dark" href={data.discordUrl} rel="noopener">
            Discord
          </a>
        )
      }
      {
        data.trailerUrl && (
          <a class="btn btn-dark" href={data.trailerUrl} rel="noopener">
            YouTube
          </a>
        )
      }
    </div>

    {
      data.gallery.length > 0 && (
        <div class="mt-10">
          <DragStrip images={data.gallery} alt={`${data.title} screenshot`} />
        </div>
      )
    }

    {
      data.press.map((p) => (
        <blockquote class="border-fry mt-10 border-l-8 pl-5 text-2xl">
          <p class="font-brand font-bold italic">&ldquo;{p.quote}&rdquo;</p>
          <footer class="mt-2 text-sm">
            &mdash; {p.url ? <a class="underline" href={p.url}>{p.source}</a> : p.source}
          </footer>
        </blockquote>
      ))
    }

    <div class="[&_h2]:text-2xl [&_h2]:mt-8 [&_ul]:list-disc [&_ul]:pl-6 mt-10 space-y-4 leading-relaxed">
      <Content />
    </div>
  </article>
</BaseLayout>
