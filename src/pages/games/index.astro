---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GameCard from '../../components/GameCard.astro';

const games = await getCollection('games');
---

<BaseLayout title="Games" description="Games made by Unlimited Fries.">
  <div class="container-page pt-36 md:pt-44">
    <p class="tag text-ash" data-reveal>Catalogue / {String(games.length).padStart(2, '0')}</p>
    <h1 class="mt-4 text-[clamp(5rem,20vw,18rem)] leading-[0.8]">
      <span class="mask"><span>Games</span></span>
    </h1>
    <div class="mt-16 space-y-24">
      {games.map((game, i) => <GameCard game={game} index={i} />)}
    </div>
  </div>
</BaseLayout>
