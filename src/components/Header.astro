---
const links = [
  { href: '/games/', label: 'Games' },
  { href: '/devlog/', label: 'Devlog' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
const path = Astro.url.pathname;
---

<header class="bg-night/90 border-ivory/10 sticky top-0 z-50 border-b backdrop-blur">
  <div class="container-page flex flex-wrap items-center justify-between gap-x-8 gap-y-2 py-4">
    <a href="/" class="font-brand text-xl leading-none font-bold uppercase italic">
      Unlimited<span class="text-fry"> Fries</span>
    </a>
    <nav aria-label="Main">
      <ul class="font-brand flex flex-wrap gap-x-6 gap-y-1 text-sm font-bold uppercase italic">
        {
          links.map((l, i) => (
            <li>
              <a
                href={l.href}
                aria-current={path.startsWith(l.href) ? 'page' : undefined}
                class="hover:text-fry aria-[current=page]:text-fry"
              >
                {l.label}
                <sup class="hud text-fry ml-0.5 not-italic">{String(i + 1).padStart(2, '0')}</sup>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
