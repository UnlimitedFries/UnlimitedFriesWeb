---
import { getCollection } from 'astro:content';

const year = new Date().getFullYear();
const games = await getCollection('games');

// TODO: confirm real contact email and social handles.
const email = 'hello@unlimitedfries.com';
const socials = [
  { label: 'X', url: 'https://x.com/grimhookgame' },
  { label: 'YouTube', url: 'https://www.youtube.com/@GrimhookGame' },
  { label: 'Discord', url: 'https://discord.gg/RYcVyEvNWr' },
];
---

<footer class="border-ivory/10 mt-24 border-t">
  <div class="container-page grid gap-10 py-14 md:grid-cols-3">
    <div>
      <p class="font-brand text-3xl leading-none font-bold uppercase italic">
        Always stay<br /><span class="text-fry">hungry.</span>
      </p>
    </div>
    <div>
      <h2 class="hud text-fry mb-3 font-sans text-xs not-italic">Games</h2>
      <ul class="space-y-1">
        {
          games.map((g) => (
            <li>
              <a class="hover:text-fry" href={`/games/${g.id}/`}>
                {g.data.title}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <h2 class="hud text-fry mb-3 font-sans text-xs not-italic">Say hi</h2>
      <p><a class="hover:text-fry underline" href={`mailto:${email}`}>{email}</a></p>
      <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-1">
        {
          socials.map((s) => (
            <li>
              <a class="hover:text-fry" href={s.url} rel="noopener">
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div class="border-ivory/10 border-t">
    <p class="container-page hud py-5 opacity-60">&copy; {year} Unlimited Fries</p>
  </div>
</footer>
