---
import { getCollection } from 'astro:content';

const year = new Date().getFullYear();
const games = await getCollection('games');

// TODO: confirm real contact email and social handles.
const email = 'hello@unlimitedfries.com';
const socials = [
  { label: 'X', url: 'https://x.com/grimhookgame' },
  { label: 'YouTube', url: 'https://www.youtube.com/@GrimhookGame' },
  { label: 'Discord', url: 'https://discord.gg/RYcVyEvNWr' },
];
---

<footer class="border-bone/10 mt-32 overflow-hidden border-t">
  <div class="container-page grid gap-12 py-16 md:grid-cols-12">
    <div class="md:col-span-5" data-reveal>
      <p class="tag text-ash">Inbox open</p>
      <a
        href={`mailto:${email}`}
        class="link-sweep mt-4 inline-block text-2xl font-medium md:text-3xl"
        data-cursor="Mail"
      >
        {email}
      </a>
    </div>
    <div class="md:col-span-3 md:col-start-7" data-reveal style="--d: 0.08s">
      <p class="tag text-ash">Games</p>
      <ul class="mt-4 space-y-2">
        {
          games.map((g) => (
            <li>
              <a class="link-sweep" href={`/games/${g.id}/`}>
                {g.data.title}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="md:col-span-3" data-reveal style="--d: 0.16s">
      <p class="tag text-ash">Elsewhere</p>
      <ul class="mt-4 space-y-2">
        {
          socials.map((s) => (
            <li>
              <a class="link-sweep" href={s.url} rel="noopener">
                {s.label} <span class="text-ash">&nearr;</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="container-page">
    <p
      class="font-display text-bone/95 pb-4 text-[calc((min(100vw,80rem)-2.5rem)/6.4)] leading-[0.85] font-black whitespace-nowrap uppercase select-none md:text-[calc((min(100vw,80rem)-5rem)/6.4)]"
      aria-hidden="true"
      data-reveal
    >
      Unlimited Fries
    </p>
  </div>

  <div class="border-bone/10 border-t">
    <div class="container-page tag text-ash flex flex-wrap justify-between gap-4 py-5">
      <span>&copy; {year} Unlimited Fries</span>
      <span>Always stay hungry</span>
      <a href="#top" class="hover:text-bone" data-back-top>Back to top &uarr;</a>
    </div>
  </div>
</footer>

<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelector('[data-back-top]')?.addEventListener('click', (e) => {
      e.preventDefault();
      scrollTo({ top: 0, behavior: 'smooth' });
    });
  });
</script>
