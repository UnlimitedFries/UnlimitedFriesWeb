---
import type { CollectionEntry } from 'astro:content';

interface Props {
  game: CollectionEntry<'games'>;
  index?: number;
}
const { game, index = 0 } = Astro.props;
const { data } = game;
const num = String(index + 1).padStart(2, '0');
---

<a
  href={`/games/${game.id}/`}
  class="group border-bone/15 grid gap-6 border-t pt-6 md:grid-cols-12 md:gap-10"
  data-cursor="View"
>
  <div class="md:col-span-7" data-tilt="4">
    <div class="bg-coal relative aspect-[16/10] overflow-hidden" data-wipe>
      {
        data.cover && (
          <img
            src={data.cover}
            alt=""
            class="h-full w-full scale-[1.08] object-cover brightness-[0.8] grayscale-[0.5] transition duration-[1.2s] ease-(--ease-out-expo) group-hover:scale-100 group-hover:brightness-100 group-hover:grayscale-0"
            loading="lazy"
          />
        )
      }
      <span class="tag bg-ink/80 absolute top-4 left-4 px-2 py-1 backdrop-blur">{data.status}</span>
    </div>
  </div>

  <div class="flex flex-col md:col-span-5">
    <span class="tag text-ash">{num}</span>
    <h3 class="mt-4 text-[clamp(3.5rem,6.5vw,6.5rem)]">
      <span class="mask"><span>{data.title}</span></span>
    </h3>
    <p class="text-bone/75 mt-6 max-w-md text-lg" data-reveal>{data.tagline}</p>

    <dl class="tag border-bone/15 mt-auto grid grid-cols-2 gap-4 border-t pt-5 max-md:mt-8">
      <div>
        <dt class="text-ash">Platform</dt>
        <dd class="mt-1">{data.platforms.join(' / ')}</dd>
      </div>
      {
        data.releaseDate && (
          <div>
            <dt class="text-ash">Released</dt>
            <dd class="mt-1">{data.releaseDate}</dd>
          </div>
        )
      }
    </dl>
    <span class="tag mt-6 inline-flex items-center gap-3">
      <span class="bg-fry h-px w-6 transition-all duration-500 ease-(--ease-out-expo) group-hover:w-14"></span>
      Explore {data.title}
    </span>
  </div>
</a>
